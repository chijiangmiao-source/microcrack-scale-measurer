{
  "name": "micro-crack-scale",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "纯前端显微裂纹标尺换算台：标尺标定、裂纹测量与毫米换算",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "@types/node": "^20.16.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.19",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
